# Must be absolute; use a persistent local volume in deployment.
DATABASE_PATH=/absolute/path/to/chars.sqlite
CFBD_API_KEY=replace-with-server-side-key
CHARS_CACHE_PATH=/absolute/durable/path/to/chars-cache
SYNC_TIMEZONE=America/Chicago
START_SEASON=1998
SCENARIO_MAX_COMPLETIONS=1000
SCENARIO_MAX_RUNTIME_MS=5000
SCENARIO_MAX_CHECKPOINT_BYTES=16777216
SCENARIO_MAX_TRACKED_POLL_PATHS=10000
