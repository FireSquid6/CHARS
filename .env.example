# Server-only; never prefix secrets with NEXT_PUBLIC_. Not required for offline tests.
CFBD_API_KEY=
# Must be absolute; use a persistent local volume in deployment.
DATABASE_PATH=/absolute/path/to/chars.sqlite
SQLITE_BUSY_TIMEOUT_MS=5000
SYNC_TIMEZONE=America/Chicago
START_SEASON=1998
SCENARIO_CPU_BUDGET_MS=30000
SCENARIO_MEMORY_BUDGET_MB=512
# Bounded scenario work per wakeup (see README for solver limitations).
SCENARIO_MAX_COMPLETIONS=1000
SCENARIO_MAX_RUNTIME_MS=5000
SCENARIO_MAX_TRACKED_POLL_PATHS=10000
