{
  "name": "chars",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": ["site", "packages/*"],
  "scripts": {
    "dev": "bun --env-file=.env run --filter site dev",
    "build": "bun run --filter app build",
    "start": "bun run --filter app start",
    "lint": "bun run --filter app lint",
    "typecheck": "bun run --filter app typegen && bun run --filter app typecheck && bun run --filter chars-db typecheck",
    "test": "bun test",
    "db:generate": "bun run --filter chars-db db:generate",
    "db:migrate": "bun packages/chars-db/src/migrate.ts"
  },
  "trustedDependencies": ["sharp", "unrs-resolver"]
}
